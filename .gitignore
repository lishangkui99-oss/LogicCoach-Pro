 # 1. 忽略系统文件
 .DS_Store
 Thumbs.db

 # 2. 忽略虚拟环境 (非常重要，不要上传几万个库文件)
 venv/
 env/
 __pycache__/
 *.pyc

 # 3. 忽略敏感配置 (绝对不能上传 API Key !)
 .env
 .env.local

 # 4. 忽略用户上传的数据 (本地运行产生的录音和数据库)
 uploads/
 data/
 *.db
 *.sqlite3
 *.jsonl

 # 5. 忽略 Cursor/VS Code 的本地配置
 .vscode/
 .cursor/
# Local runtime data and caches
chroma_db/
knowledge_base/
uploads/
venv/
__pycache__/
*.sqlite3
*.bundle
*.patch
